    {
      "name": "03 - Me",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const nacl = pm.require('npm:tweetnacl@1.0.3');",
              "const { Buffer } = require('buffer');",
              "const b64u = bytes => Buffer.from(bytes).toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/g, '');",
              "const fromB64u = value => Buffer.from(value.replace(/-/g, '+').replace(/_/g, '/') + '='.repeat((4 - value.length % 4) % 4), 'base64');",
              "const timestamp = Math.floor(Date.now() / 1000).toString();",
              "const nonce = b64u(nacl.randomBytes(16));",
              "const resolvedUrl = pm.variables.replaceIn(pm.request.url.toString());",
              "const parsed = new URL(resolvedUrl);",
              "const path = parsed.pathname + parsed.search;",
              "const rawBody = pm.request.body && pm.request.body.mode === 'raw' ? pm.variables.replaceIn(pm.request.body.raw || '') : '';",
              "const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(rawBody)));",
              "const bodyHash = Buffer.from(digest).toString('hex');",
              "const canonical = ['AW-REQUEST-V1', pm.request.method.toUpperCase(), path, timestamp, nonce, bodyHash].join('\\n');",
              "const signature = nacl.sign.detached(new TextEncoder().encode(canonical), new Uint8Array(fromB64u(pm.collectionVariables.get('authSecretKey'))));",
              "pm.request.headers.upsert({ key: 'X-AW-Device-Id', value: pm.collectionVariables.get('deviceId') });",
              "pm.request.headers.upsert({ key: 'X-AW-Timestamp', value: timestamp });",
              "pm.request.headers.upsert({ key: 'X-AW-Nonce', value: nonce });",
              "pm.request.headers.upsert({ key: 'X-AW-Signature', value: b64u(signature) });",
              "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Vault/device context klopt', () => { pm.expect(json.vaultId).to.eql(pm.collectionVariables.get('vaultId')); pm.expect(json.deviceId).to.eql(pm.collectionVariables.get('deviceId')); });"
            ]
          }
        }
      ],
