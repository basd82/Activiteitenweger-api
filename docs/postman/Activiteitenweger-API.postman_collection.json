    {
      "name": "02 - Create test vault",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const nacl = pm.require('npm:tweetnacl@1.0.3');",
              "const { Buffer } = require('buffer');",
              "const b64u = bytes => Buffer.from(bytes).toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/g, '');",
              "const vaultId = pm.variables.replaceIn('{{$guid}}');",
              "const deviceId = pm.variables.replaceIn('{{$guid}}');",
              "const signing = nacl.sign.keyPair();",
              "pm.collectionVariables.set('vaultId', vaultId);",
              "pm.collectionVariables.set('deviceId', deviceId);",
              "pm.collectionVariables.set('authPublicKey', b64u(signing.publicKey));",
              "pm.collectionVariables.set('authSecretKey', b64u(signing.secretKey));",
              "pm.collectionVariables.set('encryptionPublicKey', b64u(nacl.randomBytes(32)));",
              "pm.collectionVariables.set('keyEnvelope', b64u(nacl.randomBytes(48)));",
              "pm.collectionVariables.set('cursor', '0');",
              "pm.collectionVariables.set('cursorAfterCreate', '0');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Vault-id klopt', () => pm.expect(json.vaultId).to.eql(pm.collectionVariables.get('vaultId')));",
              "pm.test('Device-id klopt', () => pm.expect(json.deviceId).to.eql(pm.collectionVariables.get('deviceId')));",
              "pm.test('Owner heeft RW', () => { pm.expect(json.access).to.eql('RW'); pm.expect(json.owner).to.eql(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vaultId\": \"{{vaultId}}\",\n  \"deviceId\": \"{{deviceId}}\",\n  \"authPublicKey\": \"{{authPublicKey}}\",\n  \"encryptionPublicKey\": \"{{encryptionPublicKey}}\",\n  \"keyEpoch\": 1,\n  \"keyEnvelope\": \"{{keyEnvelope}}\",\n  \"keyEnvelopeNonce\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/vaults",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "vaults"
          ]
        }
      }
