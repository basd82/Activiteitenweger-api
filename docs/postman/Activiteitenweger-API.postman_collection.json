              "pm.test('API-versie is v1', () => pm.expect(json.apiVersion).to.eql(Number(pm.collectionVariables.get('apiVersion'))));",
              "pm.test('Serverversie klopt', () => pm.expect(json.serverVersion).to.eql(pm.collectionVariables.get('serverVersion')));"
