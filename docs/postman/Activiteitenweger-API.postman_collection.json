              "const fromB64u = value => Buffer.from(value.replace(/-/g, '+').replace(/_/g, '/') + '='.repeat((4 - value.length % 4) % 4), 'base64');",
              "pm.collectionVariables.set('recordId', pm.variables.replaceIn('{{$guid}}'));",
              "const revision = 1;",
              "const deleted = false;",
              "const nonceBytes = nacl.randomBytes(24);",
              "const ciphertextBytes = nacl.randomBytes(64);",
              "const nonce = b64u(nonceBytes);",
              "const ciphertext = b64u(ciphertextBytes);",
              "pm.collectionVariables.set('recordNonce', nonce);",
              "pm.collectionVariables.set('recordCiphertext', ciphertext);",
              "const cipherHashBytes = new Uint8Array(await crypto.subtle.digest('SHA-256', ciphertextBytes));",
              "const cipherHash = Buffer.from(cipherHashBytes).toString('hex');",
              "const recordCanonical = ['AW-RECORD-V1', pm.collectionVariables.get('vaultId'), pm.collectionVariables.get('recordId'), revision.toString(), '1', deleted ? '1' : '0', deleted ? '' : pm.collectionVariables.get('recordNonce'), cipherHash].join('\\n');",
              "const recordSignature = nacl.sign.detached(new TextEncoder().encode(recordCanonical), new Uint8Array(fromB64u(pm.collectionVariables.get('authSecretKey'))));",
              "pm.collectionVariables.set('recordSignature', b64u(recordSignature));",
              "const nacl = pm.require('npm:tweetnacl@1.0.3');",
              "const { Buffer } = require('buffer');",
              "const b64u = bytes => Buffer.from(bytes).toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/g, '');",
              "const fromB64u = value => Buffer.from(value.replace(/-/g, '+').replace(/_/g, '/') + '='.repeat((4 - value.length % 4) % 4), 'base64');",
