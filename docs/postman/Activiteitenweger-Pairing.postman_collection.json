              "pm.collectionVariables.set('rDeviceId',deviceId); pm.collectionVariables.set('rPublicKey',b64u(pub)); pm.collectionVariables.set('rPrivateKeyPkcs8',b64u(priv));",
              "const body=JSON.stringify({pairingSecret:pm.collectionVariables.get('rSecret'),deviceId,authPublicKey:b64u(pub),encryptionPublicKey:b64u(new Uint8Array(32).map(()=>Math.floor(Math.random()*256))) });",
              "pm.request.body.update(body);"
