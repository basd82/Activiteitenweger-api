    {
      "name": "02 - Create owner vault",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/vaults",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const { Buffer }=require('buffer');",
              "function b64u(bytes){return Buffer.from(bytes).toString('base64').replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/g,'');}",
              "function randomBytes(n){const d=new Uint8Array(n);crypto.getRandomValues(d);return d;}",
              "const kp=await crypto.subtle.generateKey({name:'Ed25519'},true,['sign','verify']);",
              "const pub=new Uint8Array(await crypto.subtle.exportKey('raw',kp.publicKey));",
              "const priv=new Uint8Array(await crypto.subtle.exportKey('pkcs8',kp.privateKey));",
              "const vaultId=pm.variables.replaceIn('{{$guid}}'); const deviceId=pm.variables.replaceIn('{{$guid}}');",
              "pm.collectionVariables.set('vaultId',vaultId); pm.collectionVariables.set('ownerDeviceId',deviceId);",
              "pm.collectionVariables.set('ownerPublicKey',b64u(pub)); pm.collectionVariables.set('ownerPrivateKeyPkcs8',b64u(priv));",
              "const body=JSON.stringify({vaultId,deviceId,authPublicKey:b64u(pub),encryptionPublicKey:b64u(randomBytes(32)),keyEpoch:1,keyEnvelope:b64u(randomBytes(80)),keyEnvelopeNonce:null});",
              "pm.request.body.update(body);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "const j=pm.response.json(); pm.test('Owner RW',()=>{pm.expect(j.owner).to.eql(true);pm.expect(j.access).to.eql('RW');});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Create R invite",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/pairing/invites",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const { Buffer } = require('buffer');",
              "function b64u(bytes) { return Buffer.from(bytes).toString('base64').replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/g,''); }",
              "function unb64u(value) { const padding='='.repeat((4-(value.length%4))%4); return new Uint8Array(Buffer.from(value.replace(/-/g,'+').replace(/_/g,'/')+padding,'base64')); }",
              "function randomBytes(length) { const data=new Uint8Array(length); crypto.getRandomValues(data); return data; }",
              "async function sha256bytes(input) { const bytes=input instanceof Uint8Array ? input : new Uint8Array(Buffer.from(String(input),'utf8')); return new Uint8Array(await crypto.subtle.digest('SHA-256', bytes)); }",
              "async function sha256hex(input) { return Buffer.from(await sha256bytes(input)).toString('hex'); }",
              "async function loadSigningKey(role) { return await crypto.subtle.importKey('pkcs8', unb64u(pm.collectionVariables.get(role+'PrivateKeyPkcs8')), {name:'Ed25519'}, false, ['sign']); }",
              "async function signRequest(role, uri, body='') {",
              "  const timestamp=Math.floor(Date.now()/1000).toString();",
              "  const nonce=b64u(randomBytes(16));",
              "  const canonical=['AW-REQUEST-V1',pm.request.method.toUpperCase(),uri,timestamp,nonce,await sha256hex(body)].join('\\n');",
              "  const key=await loadSigningKey(role);",
              "  const sig=new Uint8Array(await crypto.subtle.sign({name:'Ed25519'},key,new Uint8Array(Buffer.from(canonical,'utf8'))));",
              "  pm.request.headers.upsert({key:'X-AW-Device-Id',value:pm.collectionVariables.get(role+'DeviceId')});",
              "  pm.request.headers.upsert({key:'X-AW-Vault-Id',value:pm.collectionVariables.get('vaultId')});",
              "  pm.request.headers.upsert({key:'X-AW-Timestamp',value:timestamp});",
              "  pm.request.headers.upsert({key:'X-AW-Nonce',value:nonce});",
              "  pm.request.headers.upsert({key:'X-AW-Signature',value:b64u(sig)});",
              "  pm.request.headers.upsert({key:'Accept',value:'application/json'});",
              "}",
              "const secret=randomBytes(16); pm.collectionVariables.set('rSecret',b64u(secret));",
              "const prefix=new Uint8Array(Buffer.from('AW-PAIRING-VERIFY-V1\\n','utf8'));",
              "const merged=new Uint8Array(prefix.length+secret.length); merged.set(prefix); merged.set(secret,prefix.length);",
              "const verify=await sha256bytes(merged);",
              "const inviteId=pm.variables.replaceIn('{{$guid}}');",
              "const body=JSON.stringify({inviteId,access:'R',pairingSecretHash:b64u(verify),keyPackageCiphertext:b64u(randomBytes(96)),keyPackageNonce:b64u(randomBytes(24)),expiresInSeconds:600});",
              "pm.request.body.update(body);",
              "await signRequest('owner','/api/v1/pairing/invites',body);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.test('R grant invite',()=>pm.expect(pm.response.json().access).to.eql('R'));"
            ]
          }
        }
      ]
    },
